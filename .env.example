# Optional: GitHub Personal Access Token (Raises rate limit from 60/hr to 5,000/hr)
GITHUB_TOKEN=

# Primary AI Gateway Key (Google Gemini)
GEMINI_API_KEY=

# Open-Source AI Fallbacks (used automatically when Gemini tokens are exhausted / 429)
# Option 1: Groq Free Tier (Llama 3.1/3.3)
GROQ_API_KEY=
# Option 2: Hugging Face Inference Router (Qwen 2.5 / Llama)
HF_TOKEN=
# Option 3: OpenRouter Free Open-Source Models
OPENROUTER_API_KEY=
# Option 4: Local Ollama (auto-detected on http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional: OpenAI Key
OPENAI_API_KEY=

PORT=8080
HOST=0.0.0.0
